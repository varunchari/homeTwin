# Copy to .env and fill in. Never commit .env.
# Home Assistant (internal only — HA container has no published port)
HA_URL=http://ha:8123
HA_TOKEN=put-long-lived-ha-token-here
# Backend
BACKEND_PORT=8000
# Caddy / public site (static IP or domain — decide Day 1, don't switch mid-week)
SITE_ADDRESS=:80
# Meta Model API (SAM 3.1 + Muse Spark). Server-side only, never commit .env.
MODEL_API_KEY=put-meta-model-api-key-here
SAM_MODEL=sam-3.1
# Baseten open-weight path (Automate "Open-weight via Baseten" only).
# Server-side only, never commit .env. BASETEN_MODEL must be the exact
# model string shown in the Baseten dashboard — do not hard-code a
# dated label from an email. If either is unset, the open path returns 503.
BASETEN_API_KEY=put-baseten-api-key-here
BASETEN_MODEL=put-exact-baseten-model-string-from-dashboard-here
# Muse Image (Design Advisor / time-of-day previews, $0.01/image).
# Same MODEL_API_KEY as SAM/Spark, server-side only.
IMAGE_MODEL=muse-image-1.0
